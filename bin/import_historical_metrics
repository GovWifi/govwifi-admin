#!/usr/bin/env ruby
# frozen_string_literal: true

require "logger"
require "optparse"
require_relative "../config/boot"

module UseCases
  module PerformancePlatform; end
  module Administrator; end
end

require_relative "../lib/gateways/historical_reporting_spreadsheet"
require_relative "../lib/use_cases/performance_platform/metrics_api_publisher"
require_relative "../lib/use_cases/administrator/import_historical_metrics"

options = {
  file_path: ENV.fetch(
    "HISTORICAL_METRICS_ODS_PATH",
    Gateways::HistoricalReportingSpreadsheet::DEFAULT_FILE_PATH,
  ),
  dry_run: false,
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/import_historical_metrics [options] [ODS_FILE_PATH]"

  opts.on("-f", "--file PATH", "Path to the GovWifi Monthly Reporting Figures .ods file") do |path|
    options[:file_path] = path
  end

  opts.on("-n", "--dry-run", "Parse and validate spreadsheet without sending requests to the Metrics API") do
    options[:dry_run] = true
  end

  opts.on("-h", "--help", "Show this help message") do
    puts opts
    exit 0
  end
end

begin
  remaining_args = parser.parse(ARGV)
  options[:file_path] = remaining_args.first if remaining_args.any?

  summary = UseCases::Administrator::ImportHistoricalMetrics.new(
    file_path: options[:file_path],
    dry_run: options[:dry_run],
    logger: Logger.new($stdout),
  ).execute

  exit(summary[:failed].zero? ? 0 : 1)
rescue OptionParser::InvalidOption, OptionParser::MissingArgument, ArgumentError => e
  warn "Error: #{e.message}"
  exit 1
end
