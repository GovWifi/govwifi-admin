<% content_for :page_title, "Assume membership" %>

<h1 class="govuk-heading-l">Assume membership</h1>

<p>
  <label class="govuk-label" for="filter-input">Search by organisation name</label>
  <input type="search" id="filter-input" class="govuk-input" autocomplete="off">
</p>

<%= govuk_table do |table|
  table.with_body do |body|
    @organisations.each do |organisation|
      button_html = button_to(organisation.name, super_admin_change_organisation_path(organisation_id: organisation.id), method: :patch, class: "govuk-heading-s govuk-link button-as-link govuk-!-margin-bottom-2")
      body.with_row do |row|
        row.with_cell(text: button_html)
      end
    end
  end
end %>

<div role="status">
  <p class="govuk-body govwifi-hidden-element" id="no-results">
    <strong>No results found</strong>
  </p>
</div>

<%= render "shared/filter_search" %>
