<% content_for :page_title, "Review your MOU" %>

<div class="govuk-form-group">
  <%= link_to "Back to settings", settings_path, class: "govuk-back-link" %>

  <h1 class="govuk-heading-l">Review the MOU</h1>

  <p class="govuk-body">
    <%= current_organisation.name %> has already signed the GovWifi MOU. You can review it, or re-sign it.
  </p>

  <div class="govuk-summary-list">
    <dl class="govuk-summary-list">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Review the signed MOU</dt>
        <dd class="govuk-summary-list__value">
          <%= link_to "Review", "https://www.wifi.service.gov.uk/memorandum-of-understanding/", target: "_blank", class: "govuk-link govuk-link--no-visited-state", rel: "noopener" %>
        </dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Re-sign the MOU</dt>
        <dd class="govuk-summary-list__value">
          <%= link_to "Re-sign", confirm_resign_mou_settings_path, class: "govuk-button govuk-button--warning" %>
        </dd>
      </div>
    </dl>
  </div>
</div>
