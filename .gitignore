# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# --- Bundler & Ruby tooling ---
# Ignore bundler config.
/.bundle
.byebug_history
.gems
vendor/

# --- Node & JavaScript ---
/node_modules
/yarn-error.log
package-lock.json

# --- Databases ---
# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# --- Logs & tempfiles ---
# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# --- IDEs & OS files ---
# Ignore mac specific file that stores custom attributes
.DS_Store
# Ignore IDE files
.idea

# --- Secrets & environment ---
ci/secrets
.envrc

# --- Assets, build output & storage ---
# Ignore assets
public/assets
# SimpleCov output
coverage
# Ignore storage files
storage/
